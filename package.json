{
	"name": "cosmos",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:full": "bun run build && bunx wrangler pages dev dist/ --ip localhost --port 4321",
		"build": "vite build",
		"lint": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "bun run build && playwright test",
		"test:smoke": "bun run build && playwright test --config=playwright.smoke.config.js",
		"snyk:auth": "snyk auth",
		"snyk:test": "snyk test",
		"snyk:monitor": "snyk monitor"
	},
	"dependencies": {
		"@fontsource/outfit": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.105.0",
		"fdir": "^6.5.0",
		"hono": "^4.13.14",
		"picomatch": "^4.0.7",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"react-router-dom": "^7.18.5",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@iconify/react": "^6.0.3",
		"@playwright/test": "^1.64.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "latest",
		"jsdom": "^30.1.3",
		"snyk": "^1.1308.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	},
	"description": "Cosmos — Explora el universo con imágenes astronómicas, noticias espaciales y datos del sistema solar.",
	"keywords": [
		"react",
		"vite",
		"tailwindcss",
		"nasa-api",
		"react-router",
		"space-exploration",
		"cosmos"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ivndv/cosmos.git"
	},
	"author": "Ivan Cruz",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/ivndv/cosmos/issues"
	},
	"homepage": "https://cosmos.liuma.app/"
}
