{
	"name": "cosmos",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:full": "bun run build && bunx wrangler pages dev dist/ --ip localhost --port 4321",
		"build": "vite build",
		"lint": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "bun run build && playwright test",
		"test:smoke": "bun run build && playwright test --config=playwright.smoke.config.js"
	},
	"dependencies": {
		"@fontsource/outfit": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"hono": "^4.13.5",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"react-router-dom": "^7.18.2",
		"tailwindcss": "^4.3.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@iconify/react": "^6.0.2",
		"@playwright/test": "^1.62.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "latest",
		"jsdom": "^30.0.1",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.0"
	},
	"description": "Cosmos — Explora el universo con imágenes astronómicas, noticias espaciales y datos del sistema solar.",
	"keywords": [
		"react",
		"vite",
		"tailwindcss",
		"nasa-api",
		"react-router",
		"zustand",
		"space-exploration",
		"cosmos"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ivndv/cosmos.git"
	},
	"author": "Ivan Cruz",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/ivndv/cosmos/issues"
	},
	"homepage": "https://cosmos.mgdc.site/"
}
