# ==============================================================================
# Security Headers - Aplicados globalmente a todas las rutas
# ==============================================================================
/*
  # Previene clickjacking embebiendo el sitio en iframes
  X-Frame-Options: DENY
  
  # Previene que el navegador infiera tipos MIME distintos al declarado
  X-Content-Type-Options: nosniff
  
  # Protección XSS para navegadores legacy
  X-XSS-Protection: 1; mode=block
  
  # Política de Referrer segura para navegación cross-origin
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Deshabilita APIs y sensores del dispositivo innecesarios
  Permissions-Policy: camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  
  # Fuerza HTTPS en el navegador por 1 año con subdominios incluidos
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # Content Security Policy: NASA APOD, Cloudflare R2 Assets, YouTube embeds y fuentes
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: https://cosmos-assets.mgdc.site https://pub-58ad167276b34129820fefbbad3627c6.r2.dev https://*.nasa.gov https://*.youtube.com https://img.youtube.com; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com https://api.nasa.gov; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' https: https://cosmos-assets.mgdc.site https://pub-58ad167276b34129820fefbbad3627c6.r2.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests;

# ==============================================================================
# Cache Headers para Chunks y Assets con Hash Inmutable (Vite /assets/*)
# Edge: 30 días | Browser: 1 año (inmutable porque el hash cambia con cada build)
# ==============================================================================
/assets/*.js
  Cache-Control: public, max-age=31536000, s-maxage=2592000, immutable

/*.js
  Cache-Control: public, max-age=31536000, s-maxage=2592000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, s-maxage=2592000, immutable

/*.css
  Cache-Control: public, max-age=31536000, s-maxage=2592000, immutable

# ==============================================================================
# Fuentes Web (Outfit Fontsource)
# Edge: 30 días | Browser: 1 año
# ==============================================================================
/assets/*.woff2
  Cache-Control: public, max-age=31536000, s-maxage=2592000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, s-maxage=2592000, immutable

/assets/*.woff
  Cache-Control: public, max-age=31536000, s-maxage=2592000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, s-maxage=2592000, immutable

# ==============================================================================
# Imágenes y Favicon
# Edge: 7 días | Browser: 1 año
# ==============================================================================
/*.png
  Cache-Control: public, max-age=31536000, s-maxage=604800

/*.jpg
  Cache-Control: public, max-age=31536000, s-maxage=604800

/*.jpeg
  Cache-Control: public, max-age=31536000, s-maxage=604800

/*.svg
  Cache-Control: public, max-age=31536000, s-maxage=604800

/*.webp
  Cache-Control: public, max-age=31536000, s-maxage=604800

/*.ico
  Cache-Control: public, max-age=31536000, s-maxage=604800

# ==============================================================================
# HTML (SPA Entrypoint)
# Edge: 1 hora | Browser: revalidar siempre para recibir nuevos hashes
# ==============================================================================
/*.html
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate

/index.html
  Cache-Control: public, max-age=0, s-maxage=3600, must-revalidate

# ==============================================================================
# Manifest, Service Worker y Archivos de Indexación (SEO / AI)
# ==============================================================================
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=86400

/sitemap.xml
  Cache-Control: public, max-age=86400, s-maxage=86400

/llms.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
